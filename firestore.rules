rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function emailPasswordUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && [
          'motsu922@icloud.com',
          'miyama.firebase@gmail.com'
        ].hasAny([request.auth.token.email]);
    }
    function isRoleAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }
    function isIdmngAdmin() {
      return isAdminEmail() || isRoleAdmin();
    }
    function canUseApp() {
      return emailPasswordUser() || isIdmngAdmin();
    }
    function isAnonymousUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function canUseChangePointApp() {
      return canUseApp() || isAnonymousUser();
    }
    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    match /platform_apps/{docId} {
      allow read, write: if true;
    }
    match /platform_config/{docId} {
      allow read, write: if true;
    }
    match /quality_cases/{docId} {
      allow read, create, update, delete: if canUseApp();
    }
    match /qc_members/{docId} {
      allow read, create, update, delete: if canUseApp();
    }
    match /chat_messages/{docId} {
      allow read, create: if canUseApp();
      allow update, delete: if false;
    }
    match /fcm_tokens/{docId} {
      allow read, create, update, delete: if canUseApp();
    }
    match /system/{docId} {
      allow read, write: if canUseApp();
    }
    match /auditLogs/{docId} {
      allow create: if canUseApp();
      allow read, update, delete: if isIdmngAdmin();
    }
    match /users/{userId} {
      allow read: if isOwnUser(userId) || isIdmngAdmin();
      allow create: if isOwnUser(userId)
        && (
          isAdminEmail()
          || request.resource.data.get('role', 'user') == 'user'
        );
      allow update: if isIdmngAdmin()
        || (
          isOwnUser(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isDisabled'])
        );
      allow delete: if isIdmngAdmin();
    }
    match /devices/{docId} {
      allow read: if isSignedIn();
      allow write: if canUseApp();
    }
    match /deviceRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if canUseApp();
    }
    match /pastTroubles/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canUseApp();
    }
    match /videoManuals/{manualId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /approvalRequests/{requestId} {
      allow read, create, update: if isSignedIn();
    }
    match /viewLogs/{logId} {
      allow read, create: if isSignedIn();
    }
    match /flashTestResults/{resultId} {
      allow read, create: if isSignedIn();
    }
    // 落下品管理は画面操作なしの匿名認証を使用する。
    match /droppedItems/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'department', 'serialNo', 'quantity', 'cause', 'comment',
          'media', 'occurredAt', 'dateKey', 'createdAt', 'createdBy',
          'schemaVersion'
        ])
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.department.size() <= 100
        && request.resource.data.serialNo is string
        && request.resource.data.serialNo.size() > 0
        && request.resource.data.serialNo.size() <= 60
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 9999
        && request.resource.data.cause in ['作業', '設備', 'その他']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.media is list
        && request.resource.data.media.size() <= 6
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.schemaVersion == 1;
      allow update: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'department', 'serialNo', 'quantity', 'cause', 'comment',
          'media', 'occurredAt', 'dateKey', 'createdAt', 'createdBy',
          'schemaVersion', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.department.size() <= 100
        && request.resource.data.serialNo is string
        && request.resource.data.serialNo.size() > 0
        && request.resource.data.serialNo.size() <= 60
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 9999
        && request.resource.data.cause in ['作業', '設備', 'その他']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.media is list
        && request.resource.data.media.size() <= 6
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    // 変化点管理システムは画面操作なしの匿名認証を使用する。
    match /changepoints/{docId} {
      allow read, create, update, delete: if canUseChangePointApp();
    }
    match /anomalies/{docId} {
      allow read: if canUseChangePointApp();
    }
    match /masters/{masterId}/items/{itemId} {
      allow read, create, update, delete: if canUseChangePointApp()
        && ['department', 'line', 'changeChecklist'].hasAny([masterId]);
    }
    match /{document=**} {
      allow read, write: if canUseApp();
    }
  }
}
